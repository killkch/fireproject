# ========================================================
# Firebase 환경 변수 설정 안내 템플릿 (.env.example)
# ========================================================
# 이 파일은 어떤 환경 변수가 필요한지 알려주는 가이드용 파일입니다.
# 실제 키 값은 절대로 이 파일에 적지 마시고, 
# 이 파일을 복사하여 '.env.local' 파일을 만든 뒤 거기에 입력해 주세요.
#
# Firebase 콘솔 (https://console.firebase.google.com/)
# -> 프로젝트 설정 -> 일반 -> "내 앱"의 웹 앱(Web App) 설정에서 확인 가능합니다.
# ========================================================

# Firebase 웹 API 키
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here

# Firebase 인증 도메인 (예: your-project-id.firebaseapp.com)
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com

# Firebase 프로젝트 ID (예: your-project-id)
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id

# Cloud Storage 버킷 주소 (예: your-project-id.appspot.com 또는 your-project-id.firebasestorage.app)
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app

# Firebase 클라우드 메시징 발신자 ID
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id

# Firebase 웹 앱 고유 ID
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
